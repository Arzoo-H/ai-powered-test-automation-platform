<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd" >
<suite name="API Smoke">
	<listeners>
		<listener
			class-name="com.selenium.testng.listeners.TestListener" />
		<listener
			class-name="com.selenium.testng.listeners.RetryListener" />
		<listener
			class-name="com.selenium.testng.listeners.SuiteListener" />
	</listeners>
	<test name="QA API">
		<parameter name="env" value="qa" />
		<classes>
			<class name="com.selenium.testng.api.tests.UserApiTest" />
		</classes>
	</test>
</suite>