<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd" >
<suite name="CrossBrowserSuite" parallel="tests" thread-count="4">

	<listeners>
		<listener
			class-name="com.selenium.testng.listeners.TestListener" />
		<listener
			class-name="com.selenium.testng.listeners.RetryListener" />
		<listener
        	class-name="com.selenium.testng.listeners.SuiteListener" />
	</listeners>

	<parameter name="env" value="qa" />
	<parameter name="headless" value="true" />
	
	<test name = "testRetry">
		<classes>
			<class name="com.selenium.testng.framework.tests.RetryMechanismTest" />
		</classes>
	</test>

	<test name="Chrome-QA">
		<parameter name="browser" value="chrome" />
		<classes>
			 <class name="com.selenium.testng.web.tests.LoginTest" />
		</classes>
	</test>
</suite>
